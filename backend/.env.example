# Copie este arquivo para .env e preencha. O .env nunca vai para o repositório.

# Banco de desenvolvimento
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nespoli_dev"
# Banco usado pelos testes automáticos (o nome precisa terminar em _test)
TEST_DATABASE_URL="postgresql://usuario:senha@localhost:5432/nespoli_test"

# Chaves de 32 bytes em base64. Gere cada uma com: openssl rand -base64 32
# Use chaves diferentes em cada ambiente e nunca as reaproveite.
FIELD_ENCRYPTION_KEY=""
BLIND_INDEX_KEY=""
# Assina os tokens de sessão do login com a Apple. Sem ela, o login fica desligado.
# SESSION_SIGNING_KEY=""
# Bundle id do app (o padrão já é este)
# APPLE_BUNDLE_ID="br.com.nespoli.finance"

PORT=3000

# Pluggy (dashboard.pluggy.ai > aplicação > credenciais). Preencha as três ou nenhuma.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
# Segredo do webhook. Gere com: openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=""
# Endereço público do backend (o Pluggy precisa alcançá-lo para mandar o webhook)
PUBLIC_BASE_URL=""
