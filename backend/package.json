{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "prisma migrate deploy && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "sandbox:e2e": "tsx scripts/sandbox-e2e.ts",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pg-boss": "12.38.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
